# Copy to .env. Compose reads it; `npm run dev` needs DATABASE_URL and the admin pair exported.
POSTGRES_PASSWORD=change-me
ADMIN_USERNAME=addi
ADMIN_PASSWORD=change-me-too
# Sent to Lichess in the User-Agent so they can reach you about the importer.
CONTACT_URL=https://chess.addithurston.com
# Only for running outside Docker:
# DATABASE_URL=postgres://chess:change-me@127.0.0.1:5432/chess
